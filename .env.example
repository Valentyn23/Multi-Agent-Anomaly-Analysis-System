# ------------------------------------------------------------------------------
# PostgreSQL Configuration
# ------------------------------------------------------------------------------
POSTGRES_DB=prozorro_anomaly_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_pass_2026
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# Neo4j Graph Database Configuration (with GDS + APOC)
# ------------------------------------------------------------------------------
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_secure_pass_2026
NEO4J_HOST=localhost
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# Memory settings for Neo4j Community / GDS
