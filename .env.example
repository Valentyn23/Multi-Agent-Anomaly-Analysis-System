# ==============================================================================
# Мультиагентна система аналізу аномалій — Шаблон конфігурації середовища
# ПРИМІТКА: Скопіюйте цей файл у .env та замініть значення-плейсхолдери на власні облікові дані.
# ==============================================================================

# ------------------------------------------------------------------------------
# Конфігурація PostgreSQL
# ------------------------------------------------------------------------------
POSTGRES_DB=prozorro_anomaly_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# Конфігурація графової бази даних Neo4j (з плагінами GDS та APOC)
# ------------------------------------------------------------------------------
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_secure_neo4j_password_here
NEO4J_HOST=localhost
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# Налаштування виділення пам'яті JVM для Neo4j Community / GDS
NEO4J_HEAP_INITIAL_SIZE=512m
NEO4J_HEAP_MAX_SIZE=2G
NEO4J_PAGECACHE_SIZE=1G

# ------------------------------------------------------------------------------
# Конфігурація Redis (In-Memory сховище та брокер Celery)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_secure_redis_password_here
